# Maintainer: z23 <z23@users.noreply.github.com>
# Packages this fork's open-source gpwidget stack (not proprietary gpgui).

_pkgname=@PKG_NAME@
pkgname=${_pkgname}
pkgver="@VERSION@"
pkgrel=@REVISION@
pkgdesc="GlobalProtect VPN client (OpenConnect) with an open-source gpwidget GUI"
arch=('x86_64' 'aarch64')
url="https://github.com/z23/GlobalProtect-openconnect"
license=('GPL-3.0-only')
makedepends=('rust' 'make' 'pkgconf' 'file' 'autoconf' 'automake' 'gettext' 'libtool' 'patch')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'webkit2gtk-4.1'
  'openssl'
  'gnutls'
  'libxml2'
  'zlib'
  'lz4'
  'p11-kit'
  'nettle'
  'gmp'
  'polkit'
  'xdg-utils'
)
optdepends=(
  'gnome-keyring: store portal credentials'
)

provides=('gpclient' 'gpservice' 'gpauth' 'gpgui' 'gpwidget')

source=("${_pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

options=('!strip' '!debug')

build() {
  cd "$pkgname-$pkgver"

  # Arch CFLAGS break the bundled OpenConnect/OpenSSL link
  unset CFLAGS
  # Use distro rust (1.89+) rather than rust-toolchain.toml's rustup pin
  make build BUILD_GUI_HELPER=0 DISABLE_RUST_TOOLCHAIN=1
}

package() {
  cd "$pkgname-$pkgver"

  make install DESTDIR="$pkgdir" BUILD_GUI_HELPER=0
}
