Name:           globalprotect-openconnect
Version:        @VERSION@
Release:        @REVISION@
Summary:        A GlobalProtect VPN client powered by OpenConnect
Group:          Productivity/Networking/PPP

License:        GPL-3.0
URL:            https://github.com/yuezk/GlobalProtect-openconnect
Source:         @SOURCE@

BuildRequires:  make
BuildRequires:  libtool
BuildRequires:  autoconf
BuildRequires:  automake
BuildRequires:  gettext
BuildRequires:  gcc-c++
BuildRequires:  cargo
BuildRequires:  pkg-config
BuildRequires:  libxml2-devel
BuildRequires:  zlib-devel
BuildRequires:  (lz4-devel or liblz4-devel)
BuildRequires:  gnutls-devel
BuildRequires:  p11-kit-devel
BuildRequires:  (nettle-devel or libnettle-devel)
BuildRequires:  gmp-devel
BuildRequires:  wget
BuildRequires:  file
BuildRequires:  perl

BuildRequires:  pkgconfig(webkit2gtk-4.1)
BuildRequires:  (pkgconfig(appindicator3-0.1) or pkgconfig(ayatana-appindicator3-0.1))
BuildRequires:  gtk4-devel

BuildRequires:  (librsvg2-devel or librsvg-devel)

# gtk4-layer-shell is not packaged for EL10. A source build into /usr/local
# (https://github.com/wmww/gtk4-layer-shell) satisfies the build. The automatic
# library dependency is omitted so the package still installs there.
%global __requires_exclude ^libgtk4-layer-shell\\.so.*$

%if 0%{?suse_version}
Requires:       (libappindicator3-1 or libayatana-appindicator3-1)
%else
Requires:       (libappindicator-gtk3 or libayatana-appindicator-gtk3)
%endif
Requires:       xdg-utils
Conflicts:      globalprotect-openconnect-snapshot

%global debug_package %{nil}

%description
A GUI for GlobalProtect VPN, based on OpenConnect, supports the SSO authentication method.

%prep
%setup

%postun
if [ "$1" -eq 0 ]; then
    rm -f \
        /var/lib/gpclient/gpgui \
        /var/lib/gpclient/gpgui-nsh \
        /var/lib/gpclient/scripts/vpnc-script \
        /var/lib/gpclient/scripts/vpnc-script.metadata ||
        echo "Warning: failed to remove gpclient runtime files" >&2
    rmdir /var/lib/gpclient/scripts 2>/dev/null || :
    rmdir /var/lib/gpclient 2>/dev/null || :
fi

%build
# The injected RUSTFLAGS could fail the build
unset RUSTFLAGS
# RPM overrides PKG_CONFIG_PATH with the system dirs only. Re-add /usr/local so a
# source-built gtk4-layer-shell is found on EL10.
export PKG_CONFIG_PATH=%{_libdir}/pkgconfig:/usr/share/pkgconfig:/usr/local/lib64/pkgconfig:/usr/local/lib/pkgconfig:/usr/local/share/pkgconfig
# gpwidget supplies the gpgui path. Skip the proprietary GUI download.
make build BUILD_GUI_HELPER=0

%install
%make_install BUILD_GUI_HELPER=0

%files
%defattr(-,root,root)
%{_bindir}/*
%{_libexecdir}/gpclient/vpnc-script
%{_libexecdir}/gpclient/gp-hip-script-installer
%{_libexecdir}/gpclient/gp-vpnc-script-installer
%{_datadir}/applications/gpgui.desktop
%{_datadir}/applications/gpgui-helper.desktop
%{_datadir}/applications/gpauth.desktop
%{_datadir}/icons/hicolor/32x32/apps/gpgui.png
%{_datadir}/icons/hicolor/128x128/apps/gpgui.png
%{_datadir}/icons/hicolor/256x256/apps/gpgui.png
%{_datadir}/icons/hicolor/256x256@2/apps/gpgui.png
%{_datadir}/icons/hicolor/scalable/apps/gpgui.svg
%{_datadir}/polkit-1/actions/com.yuezk.gpgui.policy
%{_datadir}/gpwidget/

%dir /usr/lib/NetworkManager
%dir /usr/lib/NetworkManager/dispatcher.d
%dir /usr/lib/NetworkManager/dispatcher.d/pre-down.d

/usr/lib/NetworkManager/dispatcher.d/pre-down.d/gpclient.down
/usr/lib/NetworkManager/dispatcher.d/gpclient-nm-hook

%dir %{_libexecdir}
%dir %{_libexecdir}/gpclient
%dir %{_datadir}/icons/hicolor
%dir %{_datadir}/icons/hicolor/32x32
%dir %{_datadir}/icons/hicolor/32x32/apps
%dir %{_datadir}/icons/hicolor/128x128
%dir %{_datadir}/icons/hicolor/128x128/apps
%dir %{_datadir}/icons/hicolor/256x256
%dir %{_datadir}/icons/hicolor/256x256/apps
%dir %{_datadir}/icons/hicolor/256x256@2
%dir %{_datadir}/icons/hicolor/256x256@2/apps
%dir %{_datadir}/icons/hicolor/scalable
%dir %{_datadir}/icons/hicolor/scalable/apps
%dir %{_datadir}/polkit-1
%dir %{_datadir}/polkit-1/actions

%changelog
* @DATE@ Kevin Yue <k3vinyue@gmail.com> - @VERSION@
- Bugfix and improvements
