# Maintainer: z23 <z23@users.noreply.github.com>
# Builds this fork (gpwidget), not the upstream extra/AUR packages.

_pkgname_prefix=globalprotect-openconnect
pkgname="${_pkgname_prefix}-git"
pkgver=2.6.5.r0.g0000000
pkgrel=1
pkgdesc="GlobalProtect VPN client (OpenConnect) with an open-source gpwidget GUI"
arch=(x86_64 aarch64)
url="https://github.com/z23/GlobalProtect-openconnect"
license=('GPL-3.0-only')

makedepends=(
  git
  rust
  make
  pkgconf
  file
  autoconf
  automake
  gettext
  libtool
  patch
)
depends=(
  gtk4
  gtk4-layer-shell
  webkit2gtk-4.1
  openssl
  gnutls
  libxml2
  zlib
  lz4
  p11-kit
  nettle
  gmp
  polkit
  xdg-utils
  shared-mime-info
  desktop-file-utils
)
optdepends=(
  'gnome-keyring: store portal credentials'
)

conflicts=('globalprotect-openconnect')
provides=('globalprotect-openconnect' 'gpclient' 'gpservice' 'gpauth' 'gpgui' 'gpwidget')

install=gp.install

source=("${_pkgname_prefix}::git+https://github.com/z23/GlobalProtect-openconnect.git#branch=main")

sha256sums=("SKIP")

options=('!strip' '!debug')

pkgver() {
  cd "${_pkgname_prefix}"

  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${_pkgname_prefix}"
  git submodule update --init crates/openconnect/deps/openconnect

  # Distro rust, not the repo's rustup pin
  rm -f rust-toolchain.toml

  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  # Arch CFLAGS break the bundled OpenConnect/OpenSSL link
  unset CFLAGS

  cd "${_pkgname_prefix}"
  make build BUILD_GUI_HELPER=0 DISABLE_RUST_TOOLCHAIN=1 CARGO_BUILD_ARGS='--release --frozen'
}

package() {
  cd "${_pkgname_prefix}"

  make install DESTDIR="$pkgdir" BUILD_GUI_HELPER=0
}
